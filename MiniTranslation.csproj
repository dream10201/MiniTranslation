<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MiniTranslation</RootNamespace>
    <AssemblyName>MiniTranslation</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>img.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 不依赖文化敏感排序/格式化，省去 ICU 加载 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 预编译为本机代码，加快冷启动（仅影响 publish） -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 允许在非 Windows 环境（CI/交叉编译）上构建 Windows 目标 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.11" />
  </ItemGroup>

</Project>
